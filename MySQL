# Linux 定时任务脚本 
#!/bin/bash
USER="root"
PASS="你的密码"
HOST="127.0.0.1"
BACKUP_DIR="/data/mysql_backup"
# 保留7天备份
RETENTION=7
DATE=$(date +%Y%m%d_%H%M%S)
FILE="$BACKUP_DIR/db_backup_$DATE.sql.gz"

mkdir -p $BACKUP_DIR
# --single-transaction 适合InnoDB，不加锁，在线备份
mysqldump -h$HOST -u$USER -p$PASS --single-transaction --routines --triggers --all-databases | gzip > $FILE

# 清理过期
find $BACKUP_DIR -name "db_backup_*.sql.gz" -mtime +$RETENTION -delete
echo "backup done: $FILE"

