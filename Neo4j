// louvain 社区聚类 算法 
from graphdatascience import GraphDataScience
gds = GraphDataScience("bolt://localhost:7687", auth=("neo4j", "neo4j"))

# 1.图投影: 把数据库数据加载进内存 (算法必须内存投影)
G, res = gds.graph.project("graph_name", "*", "*", {"orientation":"UNDIRECTED"})
# res: nodeCount 节点数、relationshipCount 关系数

# 2.执行Louvain社区发现, 结果写回节点属性 community_id
# 内存预算: 1000万条数据 准备至少空闲 6GB 内存 
ret = gds.louvain.write(G, writeProperty="community_id")
# ret["communityCount"] 社区数量; ret["modularity"]模块度，越靠近1聚类效果越好

# 3.释放内存投影图，防止占内存
G.drop()


// python 驱动 
from neo4j import GraphDatabase

URI = "neo4j://localhost:7687"
AUTH = ("neo4j", "password")
DB_NAME = "neo4j"

def demo():
    with GraphDatabase.driver(URI, auth=AUTH) as driver:
        # 推荐统一 execute_query 写法
        records, summary, keys = driver.execute_query(
            """
            MATCH (n:Person{name: $name}) RETURN n.name AS name
            """,
            name="小明",
            database=DB_NAME
        )

        # records 查询结果列表，summary 执行统计信息
        for r in records:
            print(r["name"])

        # 读写分离
        def read_tx(tx):
            return tx.run("MATCH (n) RETURN n LIMIT 5").data()

        def write_tx(tx):
            return tx.run("MERGE (n:Person{name:$name})", name="测试").data()

        with driver.session(database=DB_NAME) as session:
            read_data = session.execute_read(read_tx)
            write_data = session.execute_write(write_tx)
