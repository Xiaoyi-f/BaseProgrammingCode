基本语法
-->
MATCH (node:Person {name: "小明"}) RETURN node 
MATCH (n) OPTIONAL MATCH (n)-[r]->(m) RETURN n, r, m // 匹配所有无对应的关系的符合条件结点, 关系自动补空 
MATCH (n) OPTIONAL n.age > 18 AND n.name CONTAINS "聂" RETURN n 
MATCH (n) WHERE n.name =~ "^聂.*" RETURN n 

CREATE (n:Person {name: "聂宝"})

MERGE (n:Person {name: "聂宝"}) RETURN n // 存在就匹配, 不存在就创建 

// 赋值 追加属性 
MATCH (n) SET n.age = 20 
MERGE (n:Person) ON CREATE SET n += {from: "文档"} ON MATCH SET n += {update_time: date()} // 现创建设置 与 已存在设置 

// 删除 
MATCH (n) DETACH DELETE n; 
MATCH (n) REMOVE n:Tag;
MATCH (n) REMOVE n.attr; 

// 导入 csv (UTF-8 无BOM头) 取出默认均为字符串类型 
LOAD CSV VITH HEADERS FROM "file://data.csv" AS row 
MERGE (n:Person {name: row.name})

// 唯一约束 
CREATE CONSTRAINT person_name_unique IF NOT EXISTS 
FOR (n:Person)
REQUIRE n.name IS UNIQUE; 

DROP CONSTRAINT person_name_unique IF EXISTS;

// 索引 
CREATE INDEX person_name_index IF NOT EXISTS 
FOR (n:Person) 
ON (n.name);

SHOW INDEXES;

DROP INDEX person_name_index IF EXISTS; 

